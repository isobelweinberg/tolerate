rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then click Publish.
//
// The app signs in anonymously, and each household's data lives under its
// share code. Nobody can list the codes, so the code acts as the password.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{code}/{collection}/{docId} {
      allow read, write: if request.auth != null
        && code.size() >= 6
        && collection in ['children', 'allergens', 'foods', 'entries'];
    }
  }
}
